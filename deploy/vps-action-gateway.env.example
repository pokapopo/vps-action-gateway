# Copy to /etc/vps-action-gateway/gateway.env and replace every placeholder.
VPS_ACTION_SOCKET=/run/vps-action-gateway/backend.sock
VPS_ACTION_WORKSPACE_ROOTS=/srv/ai-workspace
VPS_ACTION_READ_ROOTS=/srv/ai-workspace:/var/log
VPS_ACTION_JOB_ROOT=/var/lib/vps-action-gateway/jobs
VPS_ACTION_TRASH_ROOT=/var/lib/vps-action-gateway/trash
VPS_ACTION_JOB_USER=vpsagent
VPS_ACTION_POLICY_PATH=/etc/vps-action-gateway/policy.yaml
VPS_ACTION_IDEMPOTENCY_PATH=/var/lib/vps-action-gateway/idempotency.json
VPS_ACTION_INTERFACE_DIR=/etc/vps-action-gateway/interfaces.d

VPS_MCP_V2_HOST=127.0.0.1
VPS_MCP_V2_PORT=8789
VPS_MCP_V2_PATH=/mcp-v2/

VPS_MCP_OAUTH_ISSUER=https://mcp.example.com
VPS_MCP_V2_OAUTH_ISSUER=https://mcp.example.com/oauth-v2
VPS_MCP_V2_OAUTH_RESOURCE=https://mcp.example.com/mcp-v2/
VPS_MCP_OAUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# Configure at least one OAuth client. This example uses Claude's callback.
VPS_MCP_V2_OAUTH_CLIENT_ID=replace-with-client-id
VPS_MCP_V2_OAUTH_CLIENT_SECRET=replace-with-client-secret
VPS_MCP_V2_OAUTH_CALLBACK_URI=https://claude.ai/api/mcp/auth_callback

VPS_ACTION_MCP_KEY=replace-with-an-independent-random-secret
BROWSER_CONTROL_TOKEN=replace-with-a-browser-service-token
